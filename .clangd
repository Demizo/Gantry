CompileFlags:
  CompilationDatabase: "build"

  Add:
    - "-D_GNU_SOURCE"
    - "-U__clang__"
    - "--target=arm-zephyr-eabi"
    # Note: point clangd to the proper c library. The nix store hash for the zephyr sdk can be found in the compile_commands.json or in the build output.
    # Found with `/nix/store/1gdsh7plf2ab7i97z1nqrkipim84dp11-zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gcc -print-file-name=include`
    - "-isystem/nix/store/1gdsh7plf2ab7i97z1nqrkipim84dp11-zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin/../lib/gcc/arm-zephyr-eabi/14.3.0/include"
    # Found with `/nix/store/1gdsh7plf2ab7i97z1nqrkipim84dp11-zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gcc -print-file-name=include-fixed`
    - "-isystem/nix/store/1gdsh7plf2ab7i97z1nqrkipim84dp11-zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin/../lib/gcc/arm-zephyr-eabi/14.3.0/include-fixed"

  Remove:
    - "-mfp16-format=ieee"
    - "-fno-reorder-functions"
    - "-fdump-ipa-cgraph"
    - "-fno-printf-return-value"

Documentation:
  CommentFormat: Doxygen