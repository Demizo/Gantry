config GANTRY_ANALYSIS_CPPCHECK
    bool "Run cppcheck on application code"
    depends on GANTRY
    default n
    help
      Enable cppcheck static analysis on the consuming application's src/
      directory during the build.

config GANTRY_ANALYSIS_CHECK_LIBRARY
    bool "Include Gantry library sources in static analysis"
    depends on GANTRY
    default n
    help
      When enabled, cppcheck and the resource-leak checker also run over the
      Gantry library source tree. Enable during library development; leave off
      for normal application builds.
