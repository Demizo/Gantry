{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach",
            "device": "nRF52840_xxAA",
            "cwd": "${workspaceFolder}",
            "executable": "build/zephyr/zephyr.elf",
            "request": "attach",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "openocd",
            "configFiles": [
                "app/openocd.cfg"
            ],
            "interface": "swd",
            "gdbPath": "${env:ZEPHYR_SDK_INSTALL_DIR}/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
        },
    ]
}