{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach",
            "type": "probe-rs-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "chip": "${input:chip}",
            "coreConfigs": [
                {
                    "programBinary": "build/zephyr/zephyr.elf"
                }
            ]
        },
        {
            "name": "ZTest Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/tests/build/zephyr/zephyr.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
        }
    ],
    "inputs": [
        {
            "id": "chip",
            "type": "pickString",
            "description": "The board the build targets",
            "options": [
                { "label": "nrf52840dk/nrf52840", "value": "nRF52840_xxAA" },
                { "label": "nrf54l15dk/nrf54l15/cpuapp", "value": "nRF54L15" },
                { "label": "nrf54lm20dk/nrf54lm20a/cpuapp", "value": "nRF54LM20A" }
            ]
        }
    ]
}