menuconfig GANTRY
    bool "Gantry module"
    default n
    help
      Enable the Gantry module.

if GANTRY

rsource "config/Kconfig.analysis"

config GANTRY_BUILD_LIBRARY
    bool "Build Gantry sources as a Zephyr library"
    default y
    help
      When enabled, the module compiles its sources into a Zephyr library
      that is linked into the consumer app. Disable when an external build
      (e.g. the in-tree unit tests) wants to compile the sources directly.

config UNIT_TESTING
    bool "Enable unit testing build modifications"
    default n
    help
      Changes the firmware to unit testing mode (e.g. exposing some
      static functions publicly).

menuconfig GANTRY_FLAGS
    bool "Flags"
    default y
    help
      Enable runtime flag validation helpers.

if GANTRY_FLAGS
    rsource "config/Kconfig.flags"
endif

menuconfig GANTRY_MEMORY
    bool "Memory management"
    default y
    help
      Enable the reference-counted memory pool subsystem.

if GANTRY_MEMORY
    rsource "config/Kconfig.memory"
endif

menuconfig GANTRY_EVENTS
    bool "Events"
    default y
    help
      Enable the event/message-passing subsystem.

if GANTRY_EVENTS
    rsource "config/Kconfig.events"
endif

menuconfig GANTRY_STOW
    bool "Stow"
    default y
    select SETTINGS
    select FLASH
    select FLASH_MAP
    select NVS
    help
      Enable the Stow.

if GANTRY_STOW
    rsource "config/Kconfig.stow"
endif

menuconfig GANTRY_MODULE
    bool "Modules"
    default y
    help
      Enable composable application modules. A module declares its own init function and
      its own thread via GANTRY_MODULE_DEFINE, or GANTRY_LIBRARY_MODULE_DEFINE for a library
      module with init logic but no thread of its own. All registered modules are started
      automatically at boot, after Stow is initialized and before main is executed.

if GANTRY_MODULE
    rsource "config/Kconfig.module"
endif

menuconfig GANTRY_COBS_FRAMER
    bool "COBS framer"
    default n
    select NET_BUF
    help
      Enable the COBS framing module used to encode and decode COBS frames

if GANTRY_COBS_FRAMER
    rsource "config/Kconfig.cobs_framer"
endif

endif # GANTRY
