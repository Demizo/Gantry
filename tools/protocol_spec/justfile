# Run the protocol tool's tests
test *args:
  uv run --package protocol-spec pytest {{args}}

# Validate a protocol folder's vectors and check every message kind has one
[no-cd]
check folder:
  uv run --package protocol-spec --extra vectors protocol-spec check {{folder}}

# Write one message's bytes, given in hex, in a protocol folder's vector notation
[no-cd]
diag folder hex:
  @uv run --package protocol-spec --extra vectors protocol-spec diag {{folder}} {{hex}}
